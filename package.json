  "description": "Gestionale desktop per laboratori di riparazione smartphone (Android/iOS)",
  "main": "./out/main/index.js",
  "author": "Daniel",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/ensure-electron.cjs && electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.2.0"
